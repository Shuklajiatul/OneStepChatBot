                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/flows",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "flows"
                            ]
                        }
                    },
                    "response": []
                },
                {
                    "name": "Get Flow by ID",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/flows/:id",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "flows",
                                ":id"
                            ],
                            "variable": [
                                {
                                    "key": "id",
                                    "value": "FLOW_ID_HERE"
                                }
                            ]
                        }
                    },
                    "response": []
                },
                {
                    "name": "Update Flow",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}",
                                "type": "text"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name\": \"Updated Flow Name\",\n    \"nodes\": [\n        { \"id\": \"1\", \"type\": \"message\", \"data\": { \"message\": \"Hello\" } }\n    ]\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/flows/:id",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "flows",
                                ":id"
                            ],
                            "variable": [
                                {
                                    "key": "id",
                                    "value": "FLOW_ID_HERE"
                                }
                            ]
                        }
                    },
                    "response": []
                },
                {
                    "name": "Delete Flow",
                    "request": {
                        "method": "DELETE",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/flows/:id",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "flows",
                                ":id"
                            ],
                            "variable": [
                                {
                                    "key": "id",
                                    "value": "FLOW_ID_HERE"
                                }
                            ]
                        }
                    },
                    "response": []
                },
                {
                    "name": "Publish Flow",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/flows/:id/publish",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "flows",
                                ":id",
                                "publish"
                            ],
                            "variable": [
                                {
                                    "key": "id",
                                    "value": "FLOW_ID_HERE"
                                }
                            ]
                        }
                    },
                    "response": []
                },
                {
                    "name": "Unpublish Flow",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/flows/:id/unpublish",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "flows",
                                ":id",
                                "unpublish"
                            ],
                            "variable": [
                                {
                                    "key": "id",
                                    "value": "FLOW_ID_HERE"
                                }
                            ]
                        }
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "Webhooks",
            "item": [
                {
                    "name": "Verify WhatsApp Webhook",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/webhooks/whatsapp?hub.mode=subscribe&hub.verify_token=YOUR_VERIFY_TOKEN&hub.challenge=12345",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "webhooks",
                                "whatsapp"
                            ],
                            "query": [
                                {
                                    "key": "hub.mode",
                                    "value": "subscribe"
                                },
                                {
                                    "key": "hub.verify_token",
                                    "value": "YOUR_VERIFY_TOKEN"
                                },
                                {
                                    "key": "hub.challenge",
                                    "value": "12345"
                                }
                            ]
                        }
                    },
                    "response": []
                },
                {
                    "name": "Handle WhatsApp Webhook",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"object\": \"whatsapp_business_account\",\n  \"entry\": [\n    {\n      \"id\": \"WHATSAPP_BUSINESS_ACCOUNT_ID\",\n      \"changes\": [\n        {\n          \"value\": {\n            \"messaging_product\": \"whatsapp\",\n            \"metadata\": {\n              \"display_phone_number\": \"16505551111\",\n              \"phone_number_id\": \"123456123\"\n            },\n            \"contacts\": [\n              {\n                \"profile\": {\n                  \"name\": \"Test User\"\n                },\n                \"wa_id\": \"16315551181\"\n              }\n            ],\n            \"messages\": [\n              {\n                \"from\": \"16315551181\",\n                \"id\": \"wamid.HBgLMTYzMTU1NTExODEVAgASGBQzQTA3QjU1QjA3QjFCNkU4M0YA\",\n                \"timestamp\": \"1665428766\",\n                \"text\": {\n                  \"body\": \"Hello\"\n                },\n                \"type\": \"text\"\n              }\n            ]\n          },\n          \"field\": \"messages\"\n        }\n      ]\n    }\n  ]\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/webhooks/whatsapp",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "webhooks",
                                "whatsapp"
                            ]
                        }
                    },
                    "response": []
                }
            ]
        }
    ],
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:3006",
            "type": "string"
        }
    ]
